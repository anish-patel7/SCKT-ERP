# Browser: only the NEW project's public configuration.
VITE_SUPABASE_URL=https://<new-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<new-project-publishable-key>

# Server runtime public client configuration.
SUPABASE_URL=https://<new-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<new-project-publishable-key>

# Server-only: required for Admin "Add User" (Supabase Auth Admin API).
# Keep private. Never expose a service-role key through a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
